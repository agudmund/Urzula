      "y": 3541.988074167648,
      "width": 118.0,
      "height": 52.0,
      "z_value": -9.699000000000167,
      "ports_visible": false,
      "shelf_visible": false,
      "label": "Rendering",
      "depth_front": false,
      "node_tint": ""
    },
    {
      "node_id": 0,
      "node_type": "warm",
      "title": "",
      "uuid": "7eac335bbe7d484fae3811b0b0f75ef0",
      "x": 9726.633123485793,
      "y": 3681.3024940782143,
      "width": 300.0,
      "height": 200.0,
      "z_value": -9.700000000000166,
      "ports_visible": false,
      "shelf_visible": true,
      "body_text": "Four EmojiButton instances for specific actions, none of which are the More Glory shuffle:\n- `\ud83d\udc8e` Stamp source file with vision metadata\n- `\ud83d\udd0d` Read PNG metadata\n- `\u25cb` Toggle border\n- `\ud83d\udd04` Convert to PNG"
    },
