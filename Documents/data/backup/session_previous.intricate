      "y": 3370.286039117582,
      "width": 346.0,
      "height": 52.0,
      "z_value": -9.705000000000163,
      "ports_visible": false,
      "shelf_visible": false,
      "label": "JoyStatsNode \u2014 Standard Shuffle",
      "depth_front": false,
