    {
      "node_id": 0,
      "node_type": "about",
      "title": "Approach",
      "uuid": "8d717b6a53d947c88842a297273800a6",
      "x": 7600.909498339057,
      "y": 5482.662219737681,
      "width": 108.0,
      "height": 52.0,
      "z_value": -9.731000000000149,
      "ports_visible": false,
      "shelf_visible": false,
      "label": "Approach",
      "depth_front": false,
