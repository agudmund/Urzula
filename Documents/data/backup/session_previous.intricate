      "z_value": -9.861000000000077,
      "ports_visible": false,
      "shelf_visible": true,
      "body_text": "A live git status dashboard that watches every repository on the Desktop surface. What started as \"the boring but necessary node\" evolved into a fully theatrical DevOps companion with personality, offline awareness, and a dancing plushie."
    },
    {
      "node_id": 0,
      "node_type": "about",
      "title": "The Brilliant GitHub Node",
      "uuid": "c143fbeddd274d48bed851fc5d608732",
      "x": 1133.1667871815207,
      "y": 1680.8601033536938,
      "width": 278.0,
      "height": 52.0,
      "z_value": -9.862000000000076,
