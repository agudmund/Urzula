      "y": -431.7982179746448,
      "width": 168.0,
      "height": 52.0,
      "z_value": -9.76700000000013,
      "ports_visible": false,
      "shelf_visible": false,
      "label": "The Emoji Pool",
      "depth_front": false,
      "node_tint": ""
    },
    {
      "node_id": 0,
      "node_type": "warm",
      "title": "",
      "uuid": "dd4329746dbc4cb5a60127e348039dd8",
      "x": 7479.679280068708,
      "y": -860.3459763495695,
      "width": 300.0,
      "height": 232.0,
      "z_value": -9.768000000000129,
      "ports_visible": false,
      "shelf_visible": true,
      "body_text": "EmojiButton renders the glyph via `QPainter.drawText` using `Theme.healthFontFamily` at 70% of the button size constant. An `EMOJI_OVERFLOW` padding of 4px prevents glyph clipping at the bottom.\n\nThe button respects LOD gating \u2014 below 0.25 zoom, it skips rendering entirely so distant nodes stay clean."
    },
    {
      "node_id": 0,
      "node_type": "about",
      "title": "Rendering",
