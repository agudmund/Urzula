      "width": 168.0,
      "height": 52.0,
      "z_value": -9.697000000000168,
      "ports_visible": false,
      "shelf_visible": false,
      "label": "The Emoji Pool",
      "depth_front": false,
      "node_tint": ""
    },
    {
      "node_id": 0,
      "node_type": "warm",
      "title": "",
      "uuid": "b8f6e91786a94f2eb488682e7d849098",
      "x": 10976.097090431536,
      "y": 4047.517229062234,
      "width": 300.0,
      "height": 232.0,
      "z_value": -9.698000000000167,
      "ports_visible": false,
      "shelf_visible": true,
      "body_text": "EmojiButton renders the glyph via `QPainter.drawText` using `Theme.healthFontFamily` at 70% of the button size constant. An `EMOJI_OVERFLOW` padding of 4px prevents glyph clipping at the bottom.\n\nThe button respects LOD gating \u2014 below 0.25 zoom, it skips rendering entirely so distant nodes stay clean."
    },
    {
      "node_id": 0,
      "node_type": "about",
      "title": "Rendering",
      "uuid": "62024e89d00c4752b9248f602befa958",
