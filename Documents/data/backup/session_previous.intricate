      "z_value": -9.704000000000164,
      "ports_visible": false,
      "shelf_visible": true,
      "body_text": "Live joy stats display with a standard More Glory shuffle. The node that tracks joy now has its own emoji."
    },
    {
      "node_id": 0,
      "node_type": "about",
