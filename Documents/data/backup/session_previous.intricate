    {
      "node_id": 0,
      "node_type": "warm",
      "title": "",
      "uuid": "196782b31c814a11b50f3a2e8aef4dc2",
      "x": 9803.616363919147,
      "y": 2747.3710071198093,
      "width": 300.0,
