    },
    {
      "node_id": 0,
      "node_type": "warm",
      "title": "",
      "uuid": "fbaf4d4a7e984cbcaaed740d5642ffe1",
      "x": 8768.77470934819,
      "y": -1164.613125499896,
      "width": 300.0,
      "height": 200.0,
      "z_value": -9.80100000000011,
